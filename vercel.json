{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/images.js": { "maxDuration": 30 },
    "api/upload.js": { "maxDuration": 30 },
    "api/captions.js": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/images/random", "destination": "/api/images?random=1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
